# ------------------------------------------------------------------
# Public site URL (used for canonical links, sitemap, Open Graph).
# Set this in Vercel → Project → Settings → Environment Variables.
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.officeofali.com

# ------------------------------------------------------------------
# Inquiry email (Resend, free: 3,000 emails/month, 100/day).
#
#   1. Create an account at https://resend.com with your own email.
#   2. API Keys → Create → paste it here / into Vercel.
#   3. (Recommended) Domains → Add officeofali.com → add the DNS records it
#      shows to Cloudflare. Then set INQUIRY_FROM to an address on that
#      domain so replies to visitors come from the firm, not resend.dev.
#
# Without INQUIRY_FROM, inquiries are sent from onboarding@resend.dev, which
# Resend only delivers to the account owner's own address — so INQUIRY_TO
# must be the email you signed up with.
# ------------------------------------------------------------------
RESEND_API_KEY=
# Where inquiries land. This is the brokerage mailbox and matches the address
# shown on the site. Note the caveat above: until a domain is verified in
# Resend, delivery only reaches the address the Resend account was opened with,
# so verify officeofali.com (or set this to that signup address for now).
INQUIRY_TO=haiderali@serhant.com
INQUIRY_FROM=
