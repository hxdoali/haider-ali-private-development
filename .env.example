# ------------------------------------------------------------------
# Public site URL (used for canonical links, sitemap, Open Graph).
# Set this in Vercel → Project → Settings → Environment Variables.
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ------------------------------------------------------------------
# Contact form (free). Pick ONE provider — both are free tiers.
#
# Option A — Formspree (https://formspree.io, free plan)
#   Create a form, copy its endpoint, paste it here:
#   NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
#
# Option B — Web3Forms (https://web3forms.com, free plan)
#   NEXT_PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
#   NEXT_PUBLIC_FORM_ACCESS_KEY=your-web3forms-access-key
#
# If neither is set, the form falls back to opening the visitor's
# email client with a pre-filled message (mailto). Nothing breaks.
# ------------------------------------------------------------------
NEXT_PUBLIC_FORM_ENDPOINT=
NEXT_PUBLIC_FORM_ACCESS_KEY=
