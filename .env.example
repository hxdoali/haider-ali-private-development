# ------------------------------------------------------------------
# Public site URL (used for canonical links, sitemap, Open Graph).
# Set this in Vercel → Project → Settings → Environment Variables.
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.officeofali.com

# ------------------------------------------------------------------
# Inquiry email (Resend, free: 3,000 emails/month, 100/day).
#
#   1. Create the account at https://resend.com using haiderali@serhant.com.
#      This matters: with no verified sending domain, Resend delivers only to
#      the address the account was opened with, so signing up as the Serhant
#      address is what lets inquiries reach the Serhant inbox.
#   2. API Keys → Create → paste it here / into Vercel, then redeploy.
#
# Leave INQUIRY_FROM empty. A sender must sit on a domain verified in Resend,
# the brokerage owns serhant.com so it cannot be verified here, and the site
# is not to send as any other address. Empty means Resend's own
# onboarding@resend.dev carries the mail, while both emails set reply-to to
# the Serhant address — so that is the only address a visitor ever sees.
# ------------------------------------------------------------------
RESEND_API_KEY=
# Where inquiries land: the Serhant mailbox, same address the site shows.
# Both of these are honoured only on serhant.com. Anything else is ignored at
# runtime and logged, so a value left over from an earlier setup cannot quietly
# redirect inquiries or re-sign the mail.
INQUIRY_TO=haiderali@serhant.com
INQUIRY_FROM=
